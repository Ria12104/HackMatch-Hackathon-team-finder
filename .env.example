# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Copy from: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose in browser code or commit to git
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth ───────────────────────────────
# Copy from: Google Cloud Console → Credentials
# Used by local Supabase Auth provider config. Never expose the secret in browser code.
GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Optional later for Google One Tap. Not needed for Supabase OAuth redirect flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── AI / Resume extraction ─────────────────────────────────────────
OPENAI_API_KEY=

# ── Phone encryption ───────────────────────────────────────────────
PHONE_ENCRYPTION_KEY=

# ── Push notifications ─────────────────────────────────────────────
FCM_SERVER_KEY=

# ── Error tracking ─────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Admin allowlist ───────────────────────────────────────────────────────────
# Comma-separated emails that are granted admin role via Supabase Google auth
ADMIN_EMAILS=founder@example.com
